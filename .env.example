# Copy to .env (git-ignored). Every variable is documented in README.md.
DATABASE_URL=postgres://blog:blog@localhost:5432/blog
# RUST_LOG=site=debug,tower_http=debug,info
# PORT=3000
# DESIGN_DIR=
# SERPER_API_KEY=
# PUBLIC_URL=
# SELF_URL=
# MDCAST_URL=
# MDCAST_TOKEN=

# Blob storage for file and thumbnail bytes: db (default, file_blobs.data),
# fs or s3. Switch with `site_cli storage migrate --from db` first.
STORAGE_KIND=db
# fs: root directory (default ./data; created at start).
# STORAGE_DIR=./data
# s3: any S3-compatible service (AWS, Garage, MinIO, R2). Endpoint empty → AWS;
# bucket, access key and secret required; region default us-east-1.
# PATH_STYLE=true (Garage / MinIO): requests go to {endpoint}/{bucket}/{key};
# false puts the bucket into the host.
# S3_ENDPOINT=https://s3.mmik.cz
# S3_BUCKET=
# S3_REGION=garage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true

# S3 test bucket for tests/storage.rs (path-style; every test works under a
# random prefix and deletes it). The S3 tests fail, not skip, without these.
# The Makefile reads only these lines from .env — never DATABASE_URL.
TEST_S3_ENDPOINT=
TEST_S3_BUCKET=
TEST_S3_REGION=
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=
